<Window x:Class="StressLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:StressLab.Controls"
        Title="StressLab — Hardware Stress Tester"
        Width="1240" Height="820" MinWidth="1080" MinHeight="720"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20,14,20,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- thermal banner -->
        <Border x:Name="ThermalBanner" Grid.Row="0" Background="#3A1520" BorderBrush="{StaticResource DangerBrush}"
                BorderThickness="1" CornerRadius="10" Padding="14,8" Margin="0,0,0,10" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠" FontSize="16" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="ThermalBannerText" Margin="10,0,0,0" Foreground="#FFD9DE" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" Text="Thermal limit reached — the run was aborted safely."/>
            </StackPanel>
        </Border>

        <!-- header -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="40" Height="40" CornerRadius="11" Background="{StaticResource AccentGradient}">
                    <TextBlock Text="⚡" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="StressLab" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="hardware stress tester" FontSize="12" Margin="10,7,0,0" Foreground="{StaticResource TextDimBrush}"/>
                    </StackPanel>
                    <TextBlock x:Name="SystemLine" Text="Probing hardware…" FontSize="12" Margin="0,2,0,0" Foreground="{StaticResource TextDimBrush}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="AdminBadge" CornerRadius="8" Padding="10,5" VerticalAlignment="Center"
                        Background="#12251C" BorderBrush="#1F5138" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource AccentGpuBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="AdminBadgeText" Text="Administrator" FontSize="11" Margin="6,0,0,0" Foreground="#8FE3BC" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="10" Background="{StaticResource CardBrush}" Padding="12,7" Margin="10,0,0,0" VerticalAlignment="Center"
                        ToolTip="If a temperature reaches its limit, StressLab instantly stops every engine to protect your hardware.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="CPU limit" Style="{StaticResource ChipLabel}" VerticalAlignment="Center"/>
                        <TextBox x:Name="CpuLimitBox" Text="90" Width="42" Margin="6,0,0,0" TextAlignment="Center"/>
                        <TextBlock Text="°C" Style="{StaticResource ChipLabel}" Margin="4,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="GPU limit" Style="{StaticResource ChipLabel}" VerticalAlignment="Center"/>
                        <TextBox x:Name="GpuLimitBox" Text="85" Width="42" Margin="6,0,0,0" TextAlignment="Center"/>
                        <TextBlock Text="°C" Style="{StaticResource ChipLabel}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- control bar -->
        <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="14" Padding="16,12" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="PresetRow" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="CPU only" Style="{StaticResource PresetChip}" Tag="cpu" Click="Preset_Click"/>
                    <Button Content="GPU only" Style="{StaticResource PresetChip}" Tag="gpu" Margin="8,0,0,0" Click="Preset_Click"/>
                    <Button Content="RAM only" Style="{StaticResource PresetChip}" Tag="ram" Margin="8,0,0,0" Click="Preset_Click"/>
                    <Button Content="🔥 ALL TOGETHER" Style="{StaticResource PresetChip}" Tag="all" Margin="8,0,0,0" Click="Preset_Click"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Duration" Style="{StaticResource ChipLabel}" VerticalAlignment="Center"/>
                    <ComboBox x:Name="DurationBox" Width="130" Margin="8,0,0,0" SelectedIndex="3">
                        <ComboBoxItem Content="30 seconds"/>
                        <ComboBoxItem Content="1 minute"/>
                        <ComboBoxItem Content="2 minutes"/>
                        <ComboBoxItem Content="5 minutes"/>
                        <ComboBoxItem Content="15 minutes"/>
                        <ComboBoxItem Content="30 minutes"/>
                        <ComboBoxItem Content="Unlimited"/>
                    </ComboBox>
                </StackPanel>
                <Grid Grid.Column="4" VerticalAlignment="Center">
                    <Button x:Name="StartButton" Content="START TEST" Style="{StaticResource StartButton}" Click="StartStop_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- component cards -->
        <UniformGrid Grid.Row="3" Columns="3" Margin="0,14,0,0">

            <!-- ============================== CPU card -->
            <Border x:Name="CpuCard" Background="{StaticResource CardBrush}" CornerRadius="14" Padding="18" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="{StaticResource AccentCpuBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="CPU" Style="{StaticResource CardTitle}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <CheckBox x:Name="CpuEnabled" Grid.Column="1" IsChecked="True" Style="{StaticResource ToggleSwitch}"
                                  Tag="{StaticResource AccentCpuBrush}" ToolTip="Include the CPU in the stress run"
                                  Checked="EngineToggle_Changed" Unchecked="EngineToggle_Changed"/>
                    </Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,2">
                        <TextBlock x:Name="CpuBig" Text="0" Style="{StaticResource BigNumber}"/>
                        <TextBlock Text="%" Style="{StaticResource BigNumberUnit}" VerticalAlignment="Bottom" Margin="4,0,0,8"/>
                    </StackPanel>
                    <controls:GaugeBar x:Name="CpuGauge" Grid.Row="2" Value="0" Accent="{StaticResource AccentCpuBrush}"/>
                    <WrapPanel Grid.Row="3" Margin="0,10,0,0">
                        <Border Background="{StaticResource FieldBrush}" CornerRadius="8" Padding="9,5" Margin="0,0,8,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="TEMP" Style="{StaticResource ChipLabel}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CpuTempChip" Text="—" Style="{StaticResource ChipValue}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource FieldBrush}" CornerRadius="8" Padding="9,5" Margin="0,0,8,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="POWER" Style="{StaticResource ChipLabel}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CpuPowerChip" Text="—" Style="{StaticResource ChipValue}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource FieldBrush}" CornerRadius="8" Padding="9,5" Margin="0,0,8,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="CLOCK" Style="{StaticResource ChipLabel}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CpuClockChip" Text="—" Style="{StaticResource ChipValue}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                    <controls:Sparkline x:Name="CpuSpark" Grid.Row="4" Height="52" Margin="0,10,0,0"/>
                    <Grid Grid.Row="5" Margin="0,12,0,0" VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="KERNEL" Style="{StaticResource ChipLabel}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CpuKernelBox" Grid.Column="1" Margin="10,0,0,0" SelectedIndex="0">
                                <ComboBoxItem Content="Floating-point FMA (GFLOPS)"/>
                                <ComboBoxItem Content="Integer mix (branch-heavy)"/>
                                <ComboBoxItem Content="Prime sieve (cache + branch)"/>
                            </ComboBox>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="THREADS" Style="{StaticResource ChipLabel}" VerticalAlignment="Center"/>
                            <Slider x:Name="CpuThreadsSlider" Grid.Column="1" Minimum="1" Maximum="16" Value="8"
                                    Margin="10,0" VerticalAlignment="Center" ValueChanged="CpuThreadsSlider_ValueChanged"/>
                            <TextBlock x:Name="CpuThreadsValue" Grid.Column="2" Style="{StaticResource ChipValue}" Width="30"
                                       TextAlignment="Right" Text="8"/>
                        </Grid>
                        <Grid Grid.Row="2" Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="LOAD" Style="{StaticResource ChipLabel}" VerticalAlignment="Center"/>
                            <Slider x:Name="CpuLoadSlider" Grid.Column="1" Minimum="10" Maximum="100" Value="100"
                                    Margin="10,0" VerticalAlignment="Center" ValueChanged="CpuLoadSlider_ValueChanged"/>
                            <TextBlock x:Name="CpuLoadValue" Grid.Column="2" Style="{StaticResource ChipValue}" Width="36"
                                       TextAlignment="Right" Text="100%"/>
                        </Grid>
                    </Grid>
                    <TextBlock x:Name="CpuStatusLine" Grid.Row="6" Style="{StaticResource StatusText}" Margin="0,10,0,0" Text="Idle"/>
                </Grid>
            </Border>

            <!-- ============================== GPU card -->
            <Border x:Name="GpuCard" Background="{StaticResource CardBrush}" CornerRadius="14" Padding="18" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="{StaticResource AccentGpuBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="GPU" Style="{StaticResource CardTitle}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <CheckBox x:Name="GpuEnabled" Grid.Column="1" IsChecked="True" Style="{StaticResource ToggleSwitch}"
                                  Tag="{StaticResource AccentGpuBrush}" ToolTip="Include the GPU in the stress run"
                                  Checked="EngineToggle_Changed" Unchecked="EngineToggle_Changed"/>
                    </Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,2">
                        <TextBlock x:Name="GpuBig" Text="0" Style="{StaticResource BigNumber}"/>
                        <TextBlock Text="%" Style="{StaticResource BigNumberUnit}" VerticalAlignment="Bottom" Margin="4,0,0,8"/>
                    </StackPanel>
                    <controls:GaugeBar x:Name="GpuGauge" Grid.Row="2" Value="0" Accent="{StaticResource AccentGpuBrush}"/>
                    <WrapPanel Grid.Row="3" Margin="0,10,0,0">
                        <Border Background="{StaticResource FieldBrush}" CornerRadius="8" Padding="9,5" Margin="0,0,8,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="TEMP" Style="{StaticResource ChipLabel}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="GpuTempChip" Text="—" Style="{StaticResource ChipValue}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource FieldBrush}" CornerRadius="8" Padding="9,5" Margin="0,0,8,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="VRAM" Style="{StaticResource ChipLabel}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="GpuVramChip" Text="—" Style="{StaticResource ChipValue}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                    <controls:Sparkline x:Name="GpuSpark" Grid.Row="4" Height="52" Margin="0,10,0,0"/>
                    <Grid Grid.Row="5" Margin="0,12,0,0" VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="LOAD" Style="{StaticResource ChipLabel}" VerticalAlignment="Center"/>
                            <Slider x:Name="GpuLoadSlider" Grid.Column="1" Minimum="10" Maximum="100" Value="100"
                                    Margin="10,0" VerticalAlignment="Center" ValueChanged="GpuLoadSlider_ValueChanged"/>
                            <TextBlock x:Name="GpuLoadValue" Grid.Column="2" Style="{StaticResource ChipValue}" Width="36"
                                       TextAlignment="Right" Text="100%"/>
                        </Grid>
                        <TextBlock Grid.Row="1" Style="{StaticResource SmallNote}" Margin="0,9,0,0"
                                   Text="Fullscreen-triangle compute burn-in on an offscreen 1024×1024 target — no display output, no vsync cap."/>
                    </Grid>
                    <TextBlock x:Name="GpuStatusLine" Grid.Row="6" Style="{StaticResource StatusText}" Margin="0,10,0,0" Text="Idle"/>
                </Grid>
            </Border>

            <!-- ============================== RAM card -->
            <Border x:Name="RamCard" Background="{StaticResource CardBrush}" CornerRadius="14" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="{StaticResource AccentRamBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="RAM" Style="{StaticResource CardTitle}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <CheckBox x:Name="RamEnabled" Grid.Column="1" IsChecked="True" Style="{StaticResource ToggleSwitch}"
                                  Tag="{StaticResource AccentRamBrush}" ToolTip="Include the RAM in the stress run"
                                  Checked="EngineToggle_Changed" Unchecked="EngineToggle_Changed"/>
                    </Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,2">
                        <TextBlock x:Name="RamBig" Text="0" Style="{StaticResource BigNumber}"/>
                        <TextBlock Text="%" Style="{StaticResource BigNumberUnit}" VerticalAlignment="Bottom" Margin="4,0,0,8"/>
                    </StackPanel>
                    <controls:GaugeBar x:Name="RamGauge" Grid.Row="2" Value="0" Accent="{StaticResource AccentRamBrush}"/>
                    <WrapPanel Grid.Row="3" Margin="0,10,0,0">
                        <Border Background="{StaticResource FieldBrush}" CornerRadius="8" Padding="9,5" Margin="0,0,8,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="IN USE" Style="{StaticResource ChipLabel}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="RamUsedChip" Text="—" Style="{StaticResource ChipValue}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource FieldBrush}" CornerRadius="8" Padding="9,5" Margin="0,0,8,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ERRORS" Style="{StaticResource ChipLabel}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="RamErrorsChip" Text="0" Style="{StaticResource ChipValue}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                    <controls:Sparkline x:Name="RamSpark" Grid.Row="4" Height="52" Margin="0,10,0,0"/>
                    <Grid Grid.Row="5" Margin="0,12,0,0" VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="TARGET" Style="{StaticResource ChipLabel}" VerticalAlignment="Center"/>
                            <Slider x:Name="RamGbSlider" Grid.Column="1" Minimum="1" Maximum="16" Value="8"
                                    Margin="10,0" VerticalAlignment="Center" ValueChanged="RamGbSlider_ValueChanged"/>
                            <TextBlock x:Name="RamGbValue" Grid.Column="2" Style="{StaticResource ChipValue}" Width="44"
                                       TextAlignment="Right" Text="8 GB"/>
                        </Grid>
                        <CheckBox x:Name="RamVerifyBox" Grid.Row="1" Content="Verify every word (memtest-style error detection)"
                                  Style="{StaticResource MiniCheck}" IsChecked="True" Margin="0,10,0,0"/>
                        <TextBlock Grid.Row="2" Style="{StaticResource SmallNote}" Margin="0,9,0,0"
                                   Text="Cycles write + verify bit patterns through the allocated blocks. Auto-capped at 90% of physical RAM."/>
                    </Grid>
                    <TextBlock x:Name="RamStatusLine" Grid.Row="6" Style="{StaticResource StatusText}" Margin="0,10,0,0" Text="Idle"/>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- progress -->
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="RunProgress" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center"/>
            <TextBlock x:Name="TimeLine" Grid.Column="1" Style="{StaticResource ChipValue}" Margin="14,0,0,0"
                       VerticalAlignment="Center" FontFamily="Consolas" Text="00:00:00"/>
        </Grid>

        <!-- log -->
        <Border Grid.Row="5" Height="150" Margin="0,10,0,0" Background="{StaticResource CardBrush}" CornerRadius="14" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="ACTIVITY" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="ExportButton" Content="Export report" Style="{StaticResource GhostButton}"
                                IsEnabled="False" Click="Export_Click"/>
                        <Button Content="Clear" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="ClearLog_Click"/>
                    </StackPanel>
                </Grid>
                <ListBox x:Name="LogList" Grid.Row="1" Margin="0,6,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
